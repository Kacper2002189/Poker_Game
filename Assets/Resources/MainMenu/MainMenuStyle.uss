#ScreenSpace {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    background-color: rgb(20, 90, 50);
    margin: 0;
}

#MainMenu {
    background-color: rgba(0, 0, 0, 0.75);
    padding: 40px;
    border-radius: 16px;
    width: 360px;
    unity-text-align: center;
    padding-bottom: 70px;
}

#TitleLabel {
    font-size: 36px;
    color: rgb(255, 255, 255);
    margin-bottom: 20px;
    align-items: center;
}

#ButtonsContainer {
    flex-direction: column;
    justify-content: space-around;
    width: 50%;
    height: 75%;
    padding: 0;
    align-items: center;
}

#HostButtonsContainer {
    flex-direction: row;
    width: 60%;
    justify-content: space-around;
}

#JoinButtonsContainer {
    flex-direction: row;
    width: 60%;
    justify-content: space-around;
}

Button {
    width: 120px;
    height: 50px;
    font-size: 18px;
    color: rgb(255, 255, 255);
    border-radius: 8px;
    border-width: 0;
}

.host {
    background-color: rgb(24, 53, 86);
}

.join {
    background-color: rgb(22, 80, 46);
}

.back {
    background-color: rgb(89, 23, 34);
}

#HostMenu {
    background-color: rgba(0, 0, 0, 0.75);
    border-radius: 16px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 50%;
    padding: 40px;
}

#JoinMenu {
    background-color: rgba(0, 0, 0, 0.75);
    border-radius: 16px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 50%;
    padding: 40px;
}

#GameCodeContainer {
    flex-direction: row;
    margin-top: 30px;
    margin-bottom: 30px;
    align-items: center;
    justify-content: space-around;
    width: 80%;
}

#GameCode {
    background-color: rgb(19, 38, 59);
    border-width: 1px;
    border-color: white;
    border-radius: 8px;
    font-size: 20px;
    color: white;
    width: 60%;
    height: 100%;
}

TextField {
    border-radius: 8px;
    font-size: 20px;
    color: black;
    width: 60%;
    height: 100%;
}

#GameCodeLabel {
    color: rgb(255, 255, 255);
    font-size: 20px;
}

.titleLabel {
    font-size: 28px;
    color: rgb(255, 255, 255);
}
