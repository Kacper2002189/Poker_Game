    <ui:GroupBox name="gameUI" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; width: 100%; height: 100%; top: auto; justify-content: flex-end; visibility: visible; align-items: stretch; align-content: auto; flex-wrap: nowrap; flex-direction: column; align-self: auto;">
        <ui:GroupBox name="game_box" style="justify-content: space-evenly; align-self: auto; align-content: auto; align-items: stretch; height: 83.5%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
            <ui:GroupBox name="groupBox1" style="flex-direction: row; flex-wrap: nowrap; align-items: flex-start; justify-content: space-evenly; align-self: auto; align-content: auto; width: auto; height: 17%; margin-top: 0%; margin-right: 23%; margin-bottom: 0%; margin-left: 23%; padding-top: 2%; padding-right: 0; padding-bottom: 0; padding-left: 0; top: auto; flex-grow: 0; -unity-background-scale-mode: scale-and-crop;">
                <ui:VisualElement name="player3_box" style="flex-grow: 1; align-items: center;" />
                <ui:VisualElement name="player4_box" style="flex-grow: 1; align-items: center;" />
            </ui:GroupBox>
            <ui:GroupBox name="groupBox2" style="margin-top: 0%; margin-right: 0%; margin-bottom: 0%; margin-left: 0%; padding-top: 0%; padding-right: 0; padding-bottom: 0; padding-left: 0; flex-direction: row; height: 66%; background-size: 100% 100%; align-items: auto; justify-content: center; align-self: auto; align-content: auto;">
                <ui:GroupBox name="groupBox4" style="margin-top: 0; margin-right: 0%; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 2%; padding-bottom: 0; padding-left: 0; align-self: center; align-items: flex-end; justify-content: center; align-content: auto; flex-direction: column; width: 13.6%; height: auto;">
                    <ui:VisualElement name="player2_box" style="flex-grow: 1;" />
                </ui:GroupBox>
                <ui:GroupBox name="pokerTable" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; width: 67%; height: 100%; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0); flex-direction: column; justify-content: flex-start; align-self: auto; align-items: flex-start; align-content: auto; background-image: none;">
                    <ui:Instance template="pot_box" name="pot_box" style="align-items: auto; top: 29.5%; align-self: center; justify-content: flex-start; align-content: auto; flex-direction: column;" />
                    <ui:Instance template="total_pot_box" name="total_pot_box" style="position: absolute; top: 175px; left: 687px; display: none;" />
                </ui:GroupBox>
                <ui:GroupBox name="groupBox5" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0%; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 2%; width: 13.5%; height: auto; flex-direction: column; justify-content: flex-start; align-items: flex-start; align-content: auto; align-self: center;">
                    <ui:VisualElement name="player5_box" style="flex-grow: 1;" />
