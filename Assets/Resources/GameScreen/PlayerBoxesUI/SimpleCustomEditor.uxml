            <ui:GroupBox name="groupBox3" style="margin-top: 0%; margin-right: 0; margin-bottom: 0%; margin-left: 0; padding-top: 2%; padding-right: 0%; padding-bottom: 0%; padding-left: 0%; width: auto; height: 17%; flex-direction: row; align-items: flex-start; justify-content: center; align-content: center; bottom: 0%; align-self: auto;">
