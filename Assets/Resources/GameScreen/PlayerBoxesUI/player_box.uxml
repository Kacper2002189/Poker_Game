<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/GameScreen/PlayerBoxesUI/player_box.uss?fileID=7433441132597879392&amp;guid=765493494d22d9c4bb825b4ce2259df7&amp;type=3#player_box" />
    <ui:GroupBox name="player_container" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
        <ui:GroupBox name="player_container_content" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; width: 195px; height: 75px; justify-content: flex-start; align-self: auto; align-items: auto; background-image: none; background-position-x: center 0%; background-position-y: center 0; -unity-background-scale-mode: scale-and-crop; background-size: 100% 100%; -unity-slice-type: sliced; align-content: auto; opacity: 1;">
            <ui:GroupBox name="player_box" style="width: 100%; height: 100%; display: flex;">
                <ui:VisualElement name="player_image" style="background-color: rgb(0, 0, 0); border-top-width: 2px; border-right-width: 0; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(61, 67, 80); border-right-color: rgb(61, 67, 80); border-top-color: rgb(61, 67, 80); border-bottom-color: rgb(61, 67, 80); -unity-background-image-tint-color: rgba(255, 255, 255, 0.76);" />
                <ui:GroupBox focusable="false" name="player_databox">
                    <ui:VisualElement focusable="false" name="player_databox" style="border-top-width: 2px; border-right-width: 2px; border-bottom-width: 1px; border-left-width: 1px;">
                        <ui:Label text="Player01" name="player_name" />
                    </ui:VisualElement>
                    <ui:VisualElement focusable="false" name="player_chipsbox" style="border-top-width: 0; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 1px;">
                        <ui:Label text="14000" name="player_chips" />
                    </ui:VisualElement>
                </ui:GroupBox>
            </ui:GroupBox>
            <ui:Label text="High Card" name="handrank_label" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 3px; padding-right: 5px; padding-bottom: 3px; padding-left: 5px; background-size: 100% 100%; flex-direction: row; justify-content: flex-start; align-items: auto; align-self: center; align-content: auto; width: 50%; -unity-text-align: middle-center; color: rgb(255, 255, 255); background-color: rgb(21, 26, 34); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; border-left-color: rgb(61, 67, 80); border-right-color: rgb(61, 67, 80); border-top-color: rgb(61, 67, 80); border-bottom-color: rgb(61, 67, 80); font-size: 12px; top: -5px; display: none; position: relative;" />
        </ui:GroupBox>
        <ui:Label text="-2137" name="chips_positive_balance" style="align-self: flex-end; top: -28px; left: 25px; font-size: 12px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 3px; padding-right: 5px; padding-bottom: 3px; padding-left: 5px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; align-items: auto; align-content: auto; display: none; visibility: visible; background-color: rgb(15, 72, 42); border-left-color: rgb(49, 143, 64); border-right-color: rgb(49, 143, 64); border-top-color: rgb(49, 143, 64); border-bottom-color: rgb(49, 143, 64); color: rgb(1, 149, 9); opacity: 1;" />
        <ui:Label text="-2137" name="chips_negative_balance" style="align-self: flex-end; top: -28px; left: 25px; font-size: 12px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 3px; padding-right: 5px; padding-bottom: 3px; padding-left: 5px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; align-items: auto; align-content: auto; display: none; visibility: visible; color: rgb(251, 33, 18); background-color: rgb(123, 0, 0); border-left-color: rgb(201, 0, 13); border-right-color: rgb(201, 0, 13); border-top-color: rgb(201, 0, 13); border-bottom-color: rgb(201, 0, 13);" />
    </ui:GroupBox>
    <ui:VisualElement name="winner_cup" style="flex-grow: 1; background-image: resource(&apos;UI/winner_cup&apos;); width: 30px; height: 30px; background-size: 100% 100%; -unity-background-scale-mode: scale-to-fit; align-items: flex-start; align-self: flex-start; justify-content: flex-start; position: relative; top: -115px; left: 178px; display: none;" />
