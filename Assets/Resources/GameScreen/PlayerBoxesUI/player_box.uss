#player_box {
    height: 75px;
    width: 195px;
    margin: 0;
    padding: 0;
    background-color: rgb(0, 0, 0);
    border-radius: 4px;
    font-size: 8px;
    -unity-text-align: upper-left;
    justify-content: space-between;
    align-items: center;
    flex-direction: row;
}

#player_image {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgb(0, 0, 0);
    border-top-left-radius: 2px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 2px;
    margin: 0;
    padding: 0;
    flex-direction: row;
    background-image: url("project://database/Assets/Resources/UI/default-user-image.png?fileID=6773597076708211207&guid=db990c405b380e24581596466989fb2e&type=3#default-user-image_0");
}

#player_databox {
    height: 100%;
    width: 60%;
    background-color: rgb(0, 0, 0);
    margin: 0;
    padding: 0;
    border-top-left-radius: 0;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 0;
    justify-content: flex-start;
    flex-direction: column;
}

#player_databox > #player_databox {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    flex-direction: row;
    height: 50%;
    width: 100%;
    background-color: rgb(26, 30, 40);
    border-top-left-radius: 0;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-width: 0.5px;
    border-color: rgb(61, 67, 80);
    padding: 0 5px;
    margin: auto;
}

#player_name {
    color: rgb(255, 255, 255);
    width: 100%;
    height: 100%;
    font-size: 14px;
    -unity-text-align: middle-center;
    text-overflow: ellipsis;
    border-radius: 2px;
}

#player_chipsbox {
    flex-grow: 1;
    align-items: flex-start;
    justify-content: center;
    flex-direction: column-reverse;
    height: 50%;
    width: 100%;
    background-color: rgb(21, 26, 34);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 0;
    border-top-width: 0;
    border-right-width: 0.5px;
    border-bottom-width: 0.5px;
    border-left-width: 0.5px;
    border-color: rgb(61, 67, 80);
    margin: 0;
}

#player_chips {
    color: rgb(255, 255, 255);
    width: 100%;
    height: 100%;
    font-size: 12px;
    -unity-text-align: middle-center;
    text-overflow: ellipsis;
    margin: 0;
    padding: 5px;
}

#player_box.box_highlight {
    border-width: 2px;
    border-color: white;
}

#player_box.winner_highlight {
    border-width: 3px;
    border-color: gold;
}
